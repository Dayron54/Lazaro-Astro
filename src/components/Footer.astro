<style>
  .footer {
    background: #081a35;
    color: white;
    padding: 70px 40px 30px;
  }

  .footer-container {
    max-width: 1200px;
    margin: auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 2fr;
    gap: 50px;
  }

  /* Logo */
  .footer-logo {
    width: 140px;
    margin-bottom: 20px;
  }

  .footer-brand p {
    color: #a7b3c7;
    line-height: 1.6;
    max-width: 280px;
  }

  /* Títulos */
  .footer-col h4 {
    margin-bottom: 20px;
    font-size: 18px;
  }

  /* Links */
  .footer-col ul {
    list-style: none;
    padding: 0;
  }

  .footer-col ul li {
    margin-bottom: 10px;
  }

  .footer-col ul a {
    text-decoration: none;
    color: #a7b3c7;
    transition: 0.3s;
  }

  .footer-col ul a:hover {
    color: #4cc9f0;
  }

  /* iconos redes */

  .footer-redes img {
    height: 30px;
    padding: 3px;
    width: auto;
    transition: transform 0.2s;
  }

  .footer-redes img:hover {
    transform: scale(1.1);
  }

  /* WhatsApp botones */

  .contacto {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .btn-whatsapp {
    /* background:#0f274b; */
    /* padding:12px 15px; */
    /* border-radius:10px; */
    text-decoration: none;
    color: white;
    font-size: 14px;
    transition: 0.3s;
    /* border:1px solid rgba(255,255,255,0.05); */
  }

  .btn-whatsapp:hover {
    /* background:#0ea5e9; */
    transform: translateY(-2px);
  }

  /* Footer bottom */

  .footer-bottom {
    text-align: center;
    margin-top: 50px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: #8fa1b9;
    font-size: 14px;
  }

  /* Responsive */

  @media (max-width: 900px) {
    .footer-container {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 600px) {
    .footer-container {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .footer-brand p {
      margin: auto;
    }

    .contacto {
      align-items: center;
    }
  }
</style>
