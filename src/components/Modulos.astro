---
import BoxArchiveIcon from "./icons/BoxArchiveIcon.astro";
import GearIcon from "./icons/GearIcon.astro";
import IdCardIcon from "./icons/IdCardIcon.astro";
import WalletIcon from "./icons/WalletIcon.astro";
---

<section class="modulos">
  <div class="container">
    <h5 class="modulos__title">Conoce nuestros módulos</h5>

    <div class="modulos__grid">
      <!-- VENTAS E INVENTARIOS -->

      <div class="modulo">
        <div class="modulo__card">
            <div class="modulo__icon">
              <BoxArchiveIcon />
            </div>
        </div>

        <h3>Ventas e Inventarios</h3>

        <p>Control total de stock y facturación.</p>
      </div>

      <!-- CONTABLE -->

      <div class="modulo">
        <div class="modulo__card">
          <div class="modulo__icon">
            <WalletIcon />
          </div>
        </div>

        <h3>Contable y financiero</h3>

        <p>Gestión de balances y reportes.</p>
      </div>

      <!-- TALENTO HUMANO -->

      <div class="modulo">
        <div class="modulo__card">
          <div class="modulo__icon">
             <IdCardIcon />
          </div>
        </div>

        <h3>Talento humano</h3>

        <p>Nómina y gestión de personal.</p>
      </div>

      <!-- SERVICIOS ADICIONALES -->

      <div class="modulo">
        <div class="modulo__card">
          <div class="modulo__icon">
            <GearIcon />
          </div>
        </div>

        <h3>Servicios adicionales</h3>

        <p>Personalización a tu medida.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .modulos {
    /* background: #f3f4f6; */
    padding: 6rem 2rem;
    text-align: center;
  }
  .modulo__icon  {
    color: #006591;
  }

  .modulo__icon > :global(svg) {
  width: 60px !important;
  height: 60px !important;
}

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .modulos__title {
    font-size: 2.5rem;
    font-weight: 800;
    color: #111827;
    margin-bottom: 4rem;
  }

  .modulos__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3rem;
  }

  .modulo {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Card grande gris */
  .modulo__card {
    width: 90%;
    height: 240px;
    background: #e5e7eb;
    border-radius: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .modulo__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.06);
  }

  /* Bloque interno base (gris) */
  .modulo__icon {
    background: #d1d5db; /* gris suave */
    border-radius: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease;
    width: 80px;
    height: 80px;
  }

  /* Solo posiciones 2 y 4 */
  .modulo__icon.azul {
    background: #dbeafe; /* azul claro */
  }

  /* Imagen PNG */
  .modulo__icon img {
    width: 55px;
    height: auto;
    object-fit: contain;
  }

  .modulo h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 0.5rem;
  }

  .modulo p {
    font-size: 0.95rem;
    color: #6b7280;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .modulos__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .modulos__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
