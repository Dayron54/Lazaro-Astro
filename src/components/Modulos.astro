---
import BoxArchiveIcon from "./icons/BoxArchiveIcon.astro";

const modulos = [
  {
    titulo: "Ventas e Inventarios",
    descripcion: "Control total de stock y facturación.",
    icono: "/icons/icon_inventarios.png",
  },
  {
    titulo: "Contable y financiero",
    descripcion: "Gestión de balances y reportes.",
    icono: "/icons/icon_contable.png",
  },
  {
    titulo: "Talento humano",
    descripcion: "Nómina y gestión de personal.",
    icono: "/icons/icon_nomina.png",
  },
  {
    titulo: "Servicios adicionales",
    descripcion: "Personalización a tu medida.",
    icono: "/icons/icon_ajustes.png",
  }
];
---

<section class="modulos">
  <div class="container">
    <h5 class="modulos__title" style="font-weight: 700;">Conoce nuestros módulos</h5>

    <div class="modulos__grid">
      {modulos.map((modulo, index) => (
        <div class="modulo">
          <div class="modulo__card">
            <div class={`modulo__icon ${index % 2 !== 0 ? "azul" : ""}`}>
              <img src={modulo.icono} alt={modulo.titulo} />
            </div>
          </div>

          <h3>{modulo.titulo}</h3>
          <p>{modulo.descripcion}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .modulos {
    /* background: #f3f4f6; */
    padding: 6rem 2rem;
    text-align: center;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .modulos__title {
    font-size: 2.5rem;
    font-weight: 800;
    color: #111827;
    margin-bottom: 4rem;
  }

  .modulos__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3rem;
  }

  .modulo {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Card grande gris */
  .modulo__card {
    width: 90%;
    height: 240px;
    background: #e5e7eb;
    border-radius: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .modulo__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.06);
  }

/* Bloque interno base (gris) */
  .modulo__icon {
  width: 130px;
  height: 130px;
  background: #d1d5db; /* gris suave */
  border-radius: 1.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.3s ease;
}

/* Solo posiciones 2 y 4 */
.modulo__icon.azul {
  background: #dbeafe; /* azul claro */
}

  /* Imagen PNG */
  .modulo__icon img {
    width: 55px;
    height: auto;
    object-fit: contain;
  }

  .modulo h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 0.5rem;
  }

  .modulo p {
    font-size: 0.95rem;
    color: #6b7280;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .modulos__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .modulos__grid {
      grid-template-columns: 1fr;
    }
  }
</style>