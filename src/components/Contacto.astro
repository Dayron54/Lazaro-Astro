---
---

<section class="contacto">
  <div class="contacto-wrapper">

    <!-- Lado izquierdo (Formulario) -->
    <div class="contacto-left">
      <h2>Hablemos de tu negocio</h2>
      <p>
        Estamos listos para ayudarte a escalar tu empresa con
        las mejores herramientas tecnológicas.
      </p>

      <form id="contactForm">
        <input type="text" id="name" name="name" placeholder="Nombre completo" required />
        <input type="email" id="email" name="email" placeholder="Correo electrónico" required />
        <input type="tel" id="phone" name="phone" placeholder="Número de contacto" required />
        <button type="submit">Enviar mensaje</button>
      </form>
    </div>

    <!-- Lado derecho (Imagen) -->
    <div class="contacto-right">
      <img src="/Inge-Lazaro.png" alt="ing_lazaro" />
    </div>

  </div>
</section>

<script>
  if (typeof window !== "undefined") {
    document.addEventListener("DOMContentLoaded", () => {
      const form = document.getElementById("contactForm");

      form.addEventListener("submit", (e) => {
        e.preventDefault();

        const name = document.getElementById("name");
        const email = document.getElementById("email");
        const phone = document.getElementById("phone");

        if (name.value.length < 3) {
          alert("El nombre debe tener al menos 3 caracteres.");
          return;
        }

        const emailRegex = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
        if (!emailRegex.test(email.value)) {
          alert("Ingresa un correo válido.");
          return;
        }

        const phoneRegex = /^[0-9]{10}$/;
        if (!phoneRegex.test(phone.value)) {
          alert("Ingresa un número válido (10 dígitos).");
          return;
        }

        const message = `Hola

Mi nombre es: ${name.value} 
Correo: ${email.value} 
Teléfono: ${phone.value}

Estoy interesado en recibir información sobre el software.`;

        const url = `https://wa.me/573173718032?text=${encodeURIComponent(message)}`;
        window.open(url, "_blank");
      });
    });
  }
</script>

<style>
.contacto {
  background: #f3f4f6;
  padding: 6rem 2rem;
  display: flex;
  justify-content: center;
}

.contacto-wrapper {
  background: #0f4c81;
  width: 100%;
  max-width: 1200px;
  border-radius: 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  overflow: hidden;
}

/* Lado izquierdo */
.contacto-left {
  flex: 1;
  padding: 4rem;
  color: white;
}

.contacto-left h2 {
  font-size: 2.5rem;
  font-weight: 800;
  margin-bottom: 1rem;
}

.contacto-left p {
  color: #dbeafe;
  margin-bottom: 2rem;
  line-height: 1.6;
  max-width: 450px;
}

/* Formulario */
.contacto-left form {
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
  max-width: 450px;
}

.contacto-left input {
  padding: 16px 20px;
  border-radius: 40px;
  border: none;
  background: rgba(255,255,255,0.15);
  color: white;
  font-size: 16px;
  outline: none;
}

.contacto-left input::placeholder {
  color: rgba(255,255,255,0.7);
}

.contacto-left input:focus {
  background: rgba(255,255,255,0.25);
}

.contacto-left button {
  padding: 16px;
  border-radius: 40px;
  border: none;
  background: #1da1f2;
  color: white;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: 0.3s ease;
}

.contacto-left button:hover {
  background: #0ea5e9;
  transform: translateY(-2px);
}

/* Imagen derecha */
.contacto-right {
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  /* background: linear-gradient(135deg, #0f4c81, #0a3a63); */
}

.contacto-right img {
  max-height: 520px;
  width: auto;
  margin-bottom: -112px;
  object-fit: contain;
}

/* Responsive */
@media (max-width: 1024px) {
  .contacto-right img {
    padding-bottom: 0%;
  }
  .contacto-wrapper {
    flex-direction: column;
    text-align: center;
  }

  .contacto-left {
    padding: 3rem 2rem;
  }

  .contacto-left form {
    margin: 0 auto;
  }

  .contacto-right {
    width: 100%;
    padding-top: 2rem;
  }

  .contacto-right img {
    max-height: 400px;
  }
}

@media (max-width: 600px) {
  .contacto-right img {
    padding-bottom: 0%;
  }
  .contacto-left h2 {
    font-size: 2rem;
  }

  .contacto-left p {
    font-size: 14px;
  }

  .contacto-left input {
    font-size: 14px;
  }

  .contacto-left button {
    font-size: 14px;
  }
}
</style>