---
import Layout from "../layouts/Layout.astro";
import Genera from "../components/Modules/Genera.astro";
import Wemeik from "../components/Modules/Wemeik.astro";
import DesarrolloWeb from "../components/Modules/DesarrolloWeb.astro";
import CartShoppingIcon from "../components/icons/CartShoppingIcon.astro";
import BoxArchiveIcon from "../components/icons/BoxArchiveIcon.astro";
import NewsPaperIcon from "../components/icons/NewsPaperIcon.astro";
import WalletIcon from "../components/icons/WalletIcon.astro";
import UtensilsIcon from "../components/icons/UtensilsIcon.astro";
---

<Layout title="Modulos">
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <div>
          <span class="badge">Ecosistema Empresarial</span>

          <h1>
            Soluciones empresariales
            <span>inteligentes</span>
          </h1>

          <p>
            Descubre todos los módulos y productos diseñados para optimizar la
            gestión, automatizar procesos y potenciar el crecimiento de tu
            empresa.
          </p>

          <div class="hero-buttons">
            <a
              href="https://wa.me/573173718032?text=Buen%20día.%0A%0AMi%20nombre%20es%3A%0A%0AY%20requiero%20asesoría%20de%20ventas."
              class="btn btn-primary"
              target="_blank"
            >
              Solicitar asesoria
            </a>
          </div>
        </div>

        <div class="hero-image">
          <img
            id="dynamic-hero-img"
            src="/img/modules/slide1.jpg"
            alt="Dashboard empresarial"
          />
        </div>
      </div>

      <!-- TABS -->
      <div class="tabs">
        <div class="tabs-wrapper">
          <button class="tab active" data-tab="uniconet"> UNICONET </button>

          <button class="tab" data-tab="genera"> GENERA </button>

          <button class="tab" data-tab="wemeik"> WEMEIK </button>

          <button class="tab" data-tab="desarrollo">
            DESARROLLO WEB A TU MEDIDA
          </button>
        </div>
      </div>
      <!-- PRODUCTS -->
      <section class="products tab-content" id="uniconet-content">
        <div class="container">
          <div class="section-label">UNICONET</div>

          <h2 class="section-title">Todo lo que tu empresa necesita</h2>

          <p class="section-description">
            Software de ventas con facturación electrónica y modulos de
            inventrios
            <br />
            contablidad, hoteleria. Adactativo para todo tipo de empresa.
          </p>

          <div class="cards-grid">
            <!-- CARD -->
            <article class="card large">
              <div class="tag">Más popular</div>

              <div class="icon-box">
                <CartShoppingIcon />
              </div>

              <h3>Sistema de ventas POS</h3>

              <p>
                solución tecnológica, combinando software y hardware, diseñada
                para gestionar transacciones comerciales. <br />
                Modulo facturacion tactil para restaurantes <br />
                Modulo facturacion ventas para droguerias, ferreterias, almacenes,
                etc
              </p>

              <!-- <a href="#" class="card-link"> Conocer más → </a> -->
            </article>

            <!-- CARD Ventas-->
            <article class="card">
              <div class="icon-box">
                <BoxArchiveIcon />
              </div>

              <h3>Inventario Inteligente</h3>

              <p>
                Control automático de stock, alertas de reposición y gestión
                multi-bodega.
              </p>

              <!-- <a href="#" class="card-link"> Ver detalles → </a> -->
            </article>

            <!-- CARD Facturacion Electronica-->
            <article class="card">
              <div class="icon-box">
                <NewsPaperIcon />
              </div>

              <h3>Facturación Electrónica</h3>

              <p>
                Integracion de emisión directa de documentos electrónicos
                compatibles con la DIAN.
              </p>

              <!-- <a href="#" class="card-link"> Ver detalles → </a> -->
            </article>

            <!-- CARD Contabilidad-->
            <article class="card">
              <div class="icon-box">
                <WalletIcon />
              </div>

              <h3>Contabilidad Integrada</h3>

              <p>
                Reportes financieros, cartera, impuestos y flujo contable
                automatizado.
              </p>

              <!-- <a href="#" class="card-link"> Ver detalles → </a> -->
            </article>

            <!-- CARD Horeca3-->
            <article class="card dark">
              <div class="icon-box">
                <UtensilsIcon />
              </div>

              <h3>Solución Horeca</h3>

              <p>
                herramienta digital integral diseñada para gestionar de forma
                eficiente hoteles, restaurantes, cafeterías y catering
              </p>

              <!-- <a href="#" class="card-link"> Explorar → </a> -->
            </article>
          </div>
        </div>
      </section>

      <!-- CONTENIDO GENERA -->
      <section id="genera-content" class="tab-content" style="display: none;">
        <Genera />
      </section>

      <!-- CONTENIDO WEMEIK -->
      <section id="wemeik-content" class="tab-content" style="display: none;">
        <Wemeik />
      </section>

      <!-- CONTENIDO DESARROLLO -->
      <section
        id="desarrollo-content"
        class="tab-content"
        style="display: none;"
      >
        <DesarrolloWeb />
      </section>

      <!-- CTA -->
      <section class="cta-section">
        <div class="container">
          <div class="cta">
            <h2>¿Listo para transformar tu empresa?</h2>

            <p>
              Implementa soluciones empresariales modernas y lleva el control
              total de tu operación desde una sola plataforma.
            </p>

            <div class="cta-buttons">
              <a
                href="https://wa.me/573173718032?text=Buen%20día.%0A%0AMi%20nombre%20es%3A%0A%0AY%20requiero%20asesoría%20de%20ventas."
                class="btn btn-light"
                target="_blank"
              >
                Solicitar precio
              </a>
            </div>
          </div>
        </div>
      </section>

      <style>
        :root {
          --primary: #0b4ea2;
          --primary-dark: #083b7b;
          --text: #0f172a;
          --muted: #64748b;
          --bg: #f5f7fb;
          --white: #ffffff;
          --border: #e5e7eb;
        }

        * {
          margin: 0;
          padding: 0;
          box-sizing: border-box;
        }

        html {
          scroll-behavior: smooth;
        }

        body {
          font-family: Inter, system-ui, sans-serif;
          background: var(--bg);
          color: var(--text);
        }

        a {
          text-decoration: none;
          color: inherit;
        }

        .container {
          width: min(1200px, 92%);
          margin: auto;
        }

        /* HERO */

        .hero {
          padding: 5rem 0 4rem;
        }

        .hero-content {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 4rem;
          align-items: center;
        }

        .badge {
          display: inline-block;
          background: #dbeafe;
          color: var(--primary);
          padding: 0.45rem 1rem;
          border-radius: 999px;
          font-size: 0.85rem;
          font-weight: 600;
          margin-bottom: 1.5rem;
        }

        .hero h1 {
          font-size: 3.3rem;
          line-height: 1.1;
          margin-bottom: 1.5rem;
        }

        .hero h1 span {
          color: var(--primary);
        }

        .hero p {
          color: var(--muted);
          line-height: 1.7;
          margin-bottom: 2rem;
          max-width: 580px;
        }

        .hero-buttons {
          display: flex;
          gap: 1rem;
          flex-wrap: wrap;
        }

        .btn {
          padding: 0.95rem 1.5rem;
          border-radius: 12px;
          font-weight: 600;
          transition: 0.25s ease;
          display: inline-flex;
          align-items: center;
          justify-content: center;
        }

        .btn-primary {
          background: var(--primary);
          color: white;
        }

        .btn-primary:hover {
          background: var(--primary-dark);
          transform: translateY(-2px);
        }

        .btn-secondary {
          border: 1px solid var(--border);
          background: white;
        }

        .btn-secondary:hover {
          background: #f8fafc;
        }

        .hero-image {
          position: relative;
          width: 100%;
          overflow: hidden;
          display: flex;
          justify-content: center;
          align-items: center;
        }

        .hero-image img {
          width: auto;
          max-width: 100%;
          max-height: 75vh;

          display: block;
          margin: 0 auto;

          border-radius: 28px;
          object-fit: contain;

          box-shadow: 0 15px 40px rgba(0, 0, 0, 0.12);
          transition: opacity 0.8s ease-in-out;
        }

        /* TABS */

        .tabs {
          margin-top: 3rem;
          border-bottom: 1px solid #dbe3ef;
        }

        .tabs-wrapper {
          display: flex;
          gap: 2rem;
          overflow-x: auto;
        }

        .tab {
          padding: 1rem 0;
          color: #64748b;
          font-weight: 500;
          position: relative;
          white-space: nowrap;

          background: none;
          border: none;
          cursor: pointer;
          font-size: 1rem;
        }

        .tab.active {
          color: var(--text);
          font-weight: 700;
        }

        .tab.active::after {
          content: "";
          position: absolute;
          left: 0;
          bottom: 0;
          width: 100%;
          height: 3px;
          border-radius: 20px;
          background: var(--primary);
        }

        /* PRODUCTS */

        .products {
          padding: 5rem 0;
        }

        .section-label {
          color: var(--primary);
          font-size: 0.8rem;
          font-weight: 700;
          letter-spacing: 1px;
          margin-bottom: 1rem;
        }

        .section-title {
          font-size: 3rem;
          margin-bottom: 1rem;
        }

        .section-description {
          color: var(--muted);
          max-width: 750px;
          line-height: 1.8;
          margin-bottom: 3rem;
        }

        .cards-grid {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 1.5rem;
        }

        .card {
          background: white;
          border-radius: 28px;
          padding: 2rem;
          border: 1px solid #edf1f5;
          transition: 0.25s ease;
          position: relative;
          overflow: hidden;
        }

        .card:hover {
          transform: translateY(-5px);
          box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
        }

        .card.large {
          grid-column: span 2;
          min-height: 300px;
        }

        .card.dark {
          background: #073b7a;
          color: white;
        }

        .card.dark p {
          color: rgba(255, 255, 255, 0.75);
        }

        .icon-box {
          color: #006591;
          width: 58px;
          height: 58px;
          border-radius: 18px;
          background: #eff6ff;
          display: flex;
          align-items: center;
          justify-content: center;
          margin-bottom: 1.5rem;
          font-size: 1.5rem;
        }

        .icon-box > :global(svg) {
          width: 22px !important;
          height: 22px !important;
        }
        .card.dark .icon-box {
          background: rgba(255, 255, 255, 0.12);
        }

        .card h3 {
          font-size: 1.5rem;
          margin-bottom: 1rem;
        }

        .card p {
          color: var(--muted);
          line-height: 1.7;
          margin-bottom: 2rem;
        }

        .card-link {
          color: var(--primary);
          font-weight: 600;
        }

        .card.dark .card-link {
          color: white;
        }

        .tag {
          position: absolute;
          top: 1.5rem;
          right: 1.5rem;
          background: #dbeafe;
          color: var(--primary);
          padding: 0.35rem 0.8rem;
          border-radius: 999px;
          font-size: 0.75rem;
          font-weight: 700;
        }

        /* CTA */

        .cta-section {
          padding-bottom: 5rem;
        }

        .cta {
          background: linear-gradient(135deg, #0b4ea2 0%, #0d5cc2 100%);

          border-radius: 36px;
          padding: 4rem;
          color: white;
        }

        .cta h2 {
          font-size: 3rem;
          margin-bottom: 1.5rem;
        }

        .cta p {
          color: rgba(255, 255, 255, 0.82);
          max-width: 700px;
          line-height: 1.8;
          margin-bottom: 2rem;
        }

        .cta-buttons {
          display: flex;
          gap: 1rem;
          flex-wrap: wrap;
        }

        .btn-light {
          background: white;
          color: var(--text);
        }

        .btn-outline {
          border: 1px solid rgba(255, 255, 255, 0.3);
          color: white;
        }

        /* RESPONSIVE */

        @media (max-width: 1024px) {
          .hero-content {
            grid-template-columns: 1fr;
          }

          .cards-grid {
            grid-template-columns: repeat(2, 1fr);
          }

          .card.large {
            grid-column: span 2;
          }

          .footer-grid {
            grid-template-columns: repeat(2, 1fr);
          }
        }

        @media (max-width: 768px) {
          .hero {
            padding-top: 3rem;
          }

          .hero h1 {
            font-size: 2.4rem;
          }

          .section-title,
          .cta h2 {
            font-size: 2rem;
          }

          .cards-grid {
            grid-template-columns: 1fr;
          }

          .card.large {
            grid-column: span 1;
          }

          .cta {
            padding: 2rem;
          }

          .footer-grid {
            grid-template-columns: 1fr;
          }
        }
      </style>
      <script>
        const tabs = document.querySelectorAll(".tab[data-tab]");

        const uniconetContent = document.getElementById("uniconet-content");
        const generaContent = document.getElementById("genera-content");
        const wemeikContent = document.getElementById("wemeik-content");
        const desarrolloContent = document.getElementById("desarrollo-content");

        tabs.forEach((tab) => {
          tab.addEventListener("click", () => {
            // quitar active
            tabs.forEach((t) => t.classList.remove("active"));

            // activar actual
            tab.classList.add("active");

            // ocultar todo
            uniconetContent.style.display = "none";
            generaContent.style.display = "none";
            wemeikContent.style.display = "none";
            desarrolloContent.style.display = "none";

            // mostrar correspondiente
            const target = tab.dataset.tab;

            if (target === "uniconet") {
              uniconetContent.style.display = "block";
            }

            if (target === "genera") {
              generaContent.style.display = "block";
            }

            if (target === "wemeik") {
              wemeikContent.style.display = "block";
            }

            if (target === "desarrollo") {
              desarrolloContent.style.display = "block";
            }
          });
        });

        // Lógica para cambio de imagen dinámico
        const dynamicImg = document.getElementById("dynamic-hero-img");

        // Puedes agregar o quitar rutas de imágenes aquí
        const heroImages = [
          "/img/modules/slide1.jpg",
          "/img/modules/slide2.jpg",
          "/img/modules/slide3.jpg",
        ];

        let currentImgIndex = 0;

        function rotateImage() {
          currentImgIndex = (currentImgIndex + 1) % heroImages.length;

          // Efecto de desvanecimiento
          dynamicImg.style.opacity = "0";

          setTimeout(() => {
            dynamicImg.src = heroImages[currentImgIndex];
            dynamicImg.style.opacity = "1";
          }, 800); // Debe coincidir con el tiempo de la transición CSS
        }

        // Cambiar imagen cada 5 segundos
        if (heroImages.length > 1) {
          setInterval(rotateImage, 5000);
        }
      </script>
    </div>
  </section></Layout
>
