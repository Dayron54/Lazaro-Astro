<script>
  // ARRAY DE IMAGENES

  const heroImages = [
    "/img/customers/DonPedro.jpg",
    "/img/customers/colfamil.jfif",
    // "/img/customers/cliente3.jpg",
    // "/img/customers/cliente4.jpg",
  ];

  // IMG PRINCIPAL

  const heroImage = document.getElementById("heroImage");

  let currentImage = 0;

  // CAMBIO AUTOMATICO

  setInterval(() => {
    // EFECTO FADE OUT
    heroImage.style.opacity = "0";

    setTimeout(() => {
      // CAMBIAR IMAGEN
      currentImage++;

      if (currentImage >= heroImages.length) {
        currentImage = 0;
      }

      heroImage.src = heroImages[currentImage];

      // FADE IN
      heroImage.style.opacity = "1";
    }, 500);
  }, 4000);
</script>
<style>
  /* ====================================== */
  /* CONFIGURACIÓN GENERAL */
  /* ====================================== */

  .clientes-page {
    width: 100%;
    overflow: hidden;
    background: #f6f8fc;
    font-family: Arial, Helvetica, sans-serif;
  }

  /* ====================================== */
  /* HERO */
  /* ====================================== */

  .hero-clientes {
    max-width: 1300px;
    margin: auto;
    padding: 120px 40px 100px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .hero-badge {
    display: inline-block;
    background: #dbeafe;
    color: #0d4e8b;
    padding: 10px 18px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: bold;
    margin-bottom: 25px;
  }

  .hero-content h1 {
    font-size: 65px;
    line-height: 1.05;
    color: #003767;
    margin-bottom: 25px;
  }

  .hero-content p {
    font-size: 20px;
    line-height: 1.8;
    color: #4b5563;
    margin-bottom: 40px;
  }

  .hero-buttons {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }

  .btn-primary,
  .btn-secondary,
  .btn-light,
  .btn-outline {
    text-decoration: none;
    transition: 0.35s ease;
  }

  .btn-primary {
    background: #003767;
    color: white;
    padding: 18px 34px;
    border-radius: 18px;
    font-weight: bold;
    box-shadow: 0 10px 30px rgba(0, 55, 103, 0.2);
  }

  .btn-primary:hover {
    transform: translateY(-5px);
    background: #0d4e8b;
  }

  .btn-secondary {
    border: 2px solid #003767;
    color: #003767;
    padding: 16px 34px;
    border-radius: 18px;
    font-weight: bold;
  }

  .btn-secondary:hover {
    background: #003767;
    color: white;
    transform: translateY(-5px);
  }

  /* ====================================== */
  /* IMAGEN HERO */
  /* ====================================== */

  .hero-image-container {
    position: relative;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    border-radius: 45px;
    transform: rotate(3deg);
    transition: 0.6s ease;
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.12);
    object-fit: cover;

    transition:
    opacity 0.8s ease,
    transform 6s ease;
  }

  .hero-image:hover {
    transform: rotate(0deg) scale(1.02);
  }

  /* ====================================== */
  /* CARD FLOTANTE */
  /* ====================================== */

  .floating-card {
    position: absolute;
    bottom: -30px;
    left: -20px;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    padding: 22px;
    border-radius: 24px;
    display: flex;
    align-items: center;
    gap: 15px;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);

    animation: floatCard 3s ease-in-out infinite;
  }

  @keyframes floatCard {
    0% {
      transform: translateY(0px);
    }

    50% {
      transform: translateY(-10px);
    }

    100% {
      transform: translateY(0px);
    }
  }

  .floating-icon {
    width: 55px;
    height: 55px;
    border-radius: 50%;
    background: #dbeafe;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #003767;
  }

  .floating-card h3 {
    color: #003767;
    font-size: 28px;
    margin-bottom: 5px;
  }

  .floating-card p {
    color: #6b7280;
  }

  /* ====================================== */
  /* TITULOS */
  /* ====================================== */

  .section-title {
    text-align: center;
    margin-bottom: 70px;
  }

  .section-title h2 {
    font-size: 48px;
    color: #003767;
    margin-bottom: 18px;
  }

  .section-title p {
    max-width: 700px;
    margin: auto;
    font-size: 18px;
    line-height: 1.7;
    color: #6b7280;
  }

  /* ====================================== */
  /* SECTORES */
  /* ====================================== */

  .sectores-section {
    max-width: 1300px;
    margin: auto;
    padding: 100px 40px;
  }

  .sectores-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .sector-card {
    background: white;
    border-radius: 35px;
    padding: 35px;
    transition: 0.4s ease;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
    border: 1px solid #edf2f7;
  }

  .sector-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0, 55, 103, 0.12);
  }

  .sector-icon {
    width: 70px;
