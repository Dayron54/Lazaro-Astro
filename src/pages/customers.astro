                  fill="#004666"></path>
              </svg>
            </span>
          </div>

          <div>
            <h3>+5,000</h3>
            <p>Clientes Activos</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ====================================== -->
    <!-- SECTORES -->
    <!-- ====================================== -->

    <section class="sectores-section">
      <div class="section-title">
        <h2>Sectores que Transformamos</h2>

