---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Clientes | Lázaro Software">
  <main class="clientes-page">
    <!-- ====================================== -->
    <!-- HERO -->
    <!-- ====================================== -->

    <section class="hero-clientes">
      <div class="hero-content">
        <span class="hero-badge"> 30 AÑOS DE EXPERIENCIA </span>

        <h1>Confianza que impulsa a Colombia</h1>

        <p>
          Miles de empresas en todo el país utilizan nuestras soluciones para
          optimizar procesos administrativos, contables, comerciales y
          operativos.
        </p>

        <div class="hero-buttons">
          <a href="#" class="btn-primary"> Explorar Soluciones </a>

          <a href="#" class="btn-secondary"> Solicitar Demo </a>
        </div>
      </div>

      <!-- IMAGEN HERO -->

      <div class="hero-image-container">
        <!-- IMG DINAMICA -->
        <img
          id="heroImage"
          src="/img/customers/DonPedro.jpg"
          alt="Empresas clientes"
          class="hero-image"
        />

        <!-- OVERLAY -->
        <div class="hero-overlay"></div>

        <!-- CARD FLOTANTE -->
        <div class="floating-card">
          <div class="floating-icon">
            <span class="material-symbols-outlined">
              <svg
                width="25"
                height="25"
                viewBox="0 0 22 21"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
