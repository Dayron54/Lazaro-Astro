  </main>

  <!-- ========================= -->
  <!-- ESTILOS CSS -->
  <!-- ========================= -->

  <style>
    /* ========================= */
    /* CONFIGURACIÓN GENERAL */
    /* ========================= */

    .container {
      width: 90%;
      max-width: 1200px;
      margin: 0 auto;
    }

    .material-symbols-outlined {
      font-variation-settings:
        "FILL" 0,
        "wght" 400,
        "GRAD" 0,
        "opsz" 24;
    }

    /* ========================= */
    /* HERO */
    /* ========================= */

    .hero-section {
      position: relative;
      min-height: 420px;
      display: flex;
      align-items: center;
      overflow: hidden;
    }

    .hero-background {
      position: absolute;
      inset: 0;
    }

    .hero-background img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .hero-overlay {
      position: absolute;
      inset: 0;

      background: linear-gradient(180deg,
          rgba(0, 55, 103, 0.9) 0%,
          rgba(0, 55, 103, 0.7) 100%);
    }

    .hero-content {
      position: relative;
      z-index: 2;

      width: 90%;
      max-width: 1200px;
      margin: 0 auto;
    }

    .hero-text {
      max-width: 700px;
    }

    .hero-text h1 {
      font-size: 4rem;
      line-height: 1.1;
      color: white;
      margin-bottom: 24px;
    }

    .hero-text p {
      font-size: 1.2rem;
      line-height: 1.8;
      color: rgba(255, 255, 255, 0.9);
    }

    /* ========================= */
    /* ABOUT */
    /* ========================= */

    .about-section {
      padding: 100px 0;
      background: #f8fafc;
    }

    .about-container {
      width: 90%;
      max-width: 1200px;
      margin: 0 auto;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 40px;
    }

    .about-card {
      background: white;
      padding: 50px;
      border-radius: 28px;

      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }

    .about-label {
      display: block;
      margin-bottom: 24px;

      color: #0284c7;
      font-size: 0.9rem;
      font-weight: bold;
      letter-spacing: 3px;
    }

    .about-description {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .about-description p {
      line-height: 1.8;
      color: #475569;
    }

    /* ========================= */
    /* LATERAL */
    /* ========================= */

    .about-side {
      display: flex;
      flex-direction: column;
      gap: 30px;
    }

    /* ========================= */
    /* ESTADÍSTICAS */
    /* ========================= */

    .stats-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .stat-card {
      padding: 40px 20px;
      border-radius: 24px;
      text-align: center;
    }

    .stat-card h3 {
      font-size: 3rem;
      margin-bottom: 10px;
    }

    .stat-primary {
      background: #082f49;
      color: white;
    }

    .stat-light {
      background: white;
      border: 1px solid #e2e8f0;
    }

    .stat-light h3 {
      color: #082f49;
    }

    .stat-light p {
      color: #64748b;
    }

    /* ========================= */
    /* TEAM CARD */
    /* ========================= */

    .stat-card.stat-light {
      transition: transform 0.7s ease;
    }

    .stat-card.stat-light:hover {
      transform: scale(1.05);
    }

    .stat-card.stat-primary {
      transition: transform 0.7s ease;

    }

    .stat-card.stat-primary:hover {
      transform: scale(1.05);
    }

    .team-card {
      position: relative;
      height: 320px;
      width: 460px;
      overflow: hidden;
      border-radius: 28px;
    }

    .team-card img {
      width: 100%;
      height: 100%;

      object-fit: cover;

      transition: transform 0.7s ease;
    }

    .team-card:hover img {
      transform: scale(1.05);
    }

    .team-overlay {
      position: absolute;
      inset: 0;

      background: linear-gradient(to top,
          rgba(0, 0, 0, 0.8),
          rgba(0, 0, 0, 0.2),
          transparent);
    }

    .team-info {
      position: absolute;
      left: 30px;
      right: 30px;
      bottom: 30px;

      color: white;
    }

    .team-info h3 {
      font-size: 2rem;
      margin-bottom: 10px;
    }

    /* ========================= */
    /* SOPORTE */
    /* ========================= */

    .support-section {
      padding: 100px 0;
      background: white;
    }

    .section-header {
      text-align: center;
      margin-bottom: 60px;
    }

    .section-header h2 {
      font-size: 3rem;
      margin-bottom: 20px;
      color: #082f49;
    }

    .section-header p {
      max-width: 700px;
      margin: 0 auto;

      color: #64748b;
      line-height: 1.8;
    }

    .support-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 30px;
    }

    .support-card {
      background: #f8fafc;
      padding: 40px;
      border-radius: 24px;

      border: 1px solid #e2e8f0;

      transition: 0.3s ease;
    }

    .support-card:hover {
      transform: translateY(-5px);
      border-color: #0284c7;
    }

    .support-icon {
      width: 60px;
      height: 60px;

      border-radius: 18px;

      background: #e0f2fe;
      color: #0284c7;

      display: flex;
      align-items: center;
      justify-content: center;

      margin-bottom: 24px;
    }

    .support-card h3 {
      font-size: 1.7rem;
      margin-bottom: 16px;
    }

    .support-card p {
      color: #64748b;
