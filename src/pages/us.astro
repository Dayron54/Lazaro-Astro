                    fill="#006591" />
                </svg>

              </span>
            </div>

            <h3>
              Ventas
            </h3>

            <p>
              Asesoría comercial y licenciamiento para empresas.
            </p>

            <div class="support-phone">

              <span class="material-symbols-outlined">
                Cel y Whatsapp:
              </span>

              <span>
                <a href="https://wa.me/573173718032?text=Buen%20día.%0A%0AMi%20nombre%20es%3A%0A%0AY%20requiero%20asesoría%20de%20ventas."
                  target="_blank" style="text-decoration: none; color: #082f49;">
                  +57 317 3718032</a>
              </span>

            </div>

          </div>

          <!-- CARD TECNICO -->
          <div class="support-card">

            <div class="support-icon">
              <span class="material-symbols-outlined">
