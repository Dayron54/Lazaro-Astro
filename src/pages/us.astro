                  <path
                    d="M8 14H10L10.3 12.5C10.5 12.4167 10.6875 12.3292 10.8625 12.2375C11.0375 12.1458 11.2167 12.0333 11.4 11.9L12.85 12.35L13.85 10.65L12.7 9.65C12.7333 9.41667 12.75 9.2 12.75 9C12.75 8.8 12.7333 8.58333 12.7 8.35L13.85 7.35L12.85 5.65L11.4 6.1C11.2167 5.96667 11.0375 5.85417 10.8625 5.7625C10.6875 5.67083 10.5 5.58333 10.3 5.5L10 4H8L7.7 5.5C7.5 5.58333 7.3125 5.67083 7.1375 5.7625C6.9625 5.85417 6.78333 5.96667 6.6 6.1L5.15 5.65L4.15 7.35L5.3 8.35C5.26667 8.58333 5.25 8.8 5.25 9C5.25 9.2 5.26667 9.41667 5.3 9.65L4.15 10.65L5.15 12.35L6.6 11.9C6.78333 12.0333 6.9625 12.1458 7.1375 12.2375C7.3125 12.3292 7.5 12.4167 7.7 12.5L8 14ZM9 11C8.45 11 7.97917 10.8042 7.5875 10.4125C7.19583 10.0208 7 9.55 7 9C7 8.45 7.19583 7.97917 7.5875 7.5875C7.97917 7.19583 8.45 7 9 7C9.55 7 10.0208 7.19583 10.4125 7.5875C10.8042 7.97917 11 8.45 11 9C11 9.55 10.8042 10.0208 10.4125 10.4125C10.0208 10.8042 9.55 11 9 11ZM2 18C1.45 18 0.979167 17.8042 0.5875 17.4125C0.195833 17.0208 0 16.55 0 16V2C0 1.45 0.195833 0.979167 0.5875 0.5875C0.979167 0.195833 1.45 0 2 0H16C16.55 0 17.0208 0.195833 17.4125 0.5875C17.8042 0.979167 18 1.45 18 2V16C18 16.55 17.8042 17.0208 17.4125 17.4125C17.0208 17.8042 16.55 18 16 18H2ZM2 16H16V2H2V16Z"
                    fill="#006591" />
                </svg>


              </span>
            </div>

            <h3>
              Soporte Técnico
            </h3>

            <p>
              Soporte técnico especializado para nuestras soluciones empresariales.
            </p>

            <div class="support-phone">

              <span class="material-symbols-outlined">
                Whatsapp:
              </span>

              <span>
                <a href="https://wa.me/573168204407?text=Buen%20día%2C%20necesito%20soporte%20técnico.%0AMi%20nombre%20es%3A%0ADe%20la%20empresa%3A%0ADe%20la%20ciudad%3A%0A%0ALa%20falla%20es%3A"
                  target="_blank" rel="noopener noreferrer" style="text-decoration: none; color: #082f49;">
                  +57 3168204407</a>

              </span>

            </div>

          </div>

          <!-- CARD SOPORTE -->
          <div class="support-card">

            <div class="support-icon">
              <span class="material-symbols-outlined">
                <svg width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path
