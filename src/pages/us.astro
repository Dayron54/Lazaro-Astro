---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Nosotros | Lázaro Software">

  <main>

    <!-- ========================= -->
    <!-- HERO PRINCIPAL -->
    <!-- ========================= -->

    <section class="hero-section">

      <!-- Imagen de fondo -->
      <div class="hero-background">

        <img src="/img/us/office.jpg" alt="Lázaro Software" />

        <!-- Capa oscura -->
        <div class="hero-overlay"></div>

      </div>

      <!-- Contenido -->
      <div class="hero-content">

        <div class="hero-text">

          <h1>
            Nuestra Historia y Compromiso
          </h1>

          <p>
            Más de 30 años desarrollando soluciones tecnológicas para empresas,
            optimizando procesos administrativos, contables y comerciales.
          </p>

        </div>

      </div>

    </section>

    <!-- ========================= -->
    <!-- SECCIÓN NOSOTROS -->
    <!-- ========================= -->

    <section class="about-section">

      <div class="about-container">

        <div class="about-grid">

          <!-- TEXTO -->
          <div class="about-card">

            <span class="about-label">
              QUIÉNES SOMOS
            </span>

            <div class="about-description">

              <p>
                Lázaro Software es una empresa 100% Tolimense con más de 30 años
                de experiencia desarrollando soluciones informáticas eficientes
                para empresas de diferentes sectores.
              </p>

              <p>
                Nos hemos destacado por la calidad de nuestros productos, el
                compromiso con nuestros clientes y el acompañamiento técnico
                permanente que ofrecemos a cada organización.
              </p>

              <p>
                Diseñamos herramientas robustas, intuitivas y funcionales para
                optimizar procesos de ventas, inventarios, contabilidad,
                facturación electrónica y administración empresarial.
              </p>

              <p>
                Nuestro objetivo es brindar soluciones tecnológicas que ayuden a
                las empresas a crecer, mejorar el control operativo y tomar
                decisiones más inteligentes.
              </p>

            </div>

          </div>

          <!-- LATERAL -->
          <div class="about-side">

            <!-- ESTADÍSTICAS -->
            <div class="stats-grid">

              <div class="stat-card stat-primary">

                <h3>30+</h3>

                <p>
                  Años de experiencia
                </p>

              </div>

              <div class="stat-card stat-light">

                <h3>100%</h3>

                <p>
                  Talento Tolimense
                </p>

              </div>

            </div>

            <!-- IMAGEN -->
            <div class="team-card">

              <img src="/img/us/us.png" alt="Equipo Lázaro Software" />

              <div class="team-overlay"></div>

              <div class="team-info">

                <h3>
                  Excelencia Técnica
                </h3>

                <p>
                  Innovación y compromiso en cada solución.
                </p>

              </div>

            </div>

          </div>

        </div>

      </div>

    </section>

    <!-- ========================= -->
    <!-- SOPORTE -->
    <!-- ========================= -->

    <section class="support-section">

      <div class="container">

        <!-- TITULO -->
        <div class="section-header">

          <h2>
            Soporte y Atención
          </h2>

          <p>
            Nuestro equipo está listo para ayudarte y acompañarte
            en cada etapa del crecimiento de tu empresa.
          </p>

        </div>

        <!-- CARDS -->
        <div class="support-grid">

          <!-- CARD VENTAS-->
          <div class="support-card">

            <div class="support-icon">
              <span class="material-symbols-outlined">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
