---
import Layout from "../layouts/Layout.astro";
import WhatsappIcon from "../components/icons/whatsappIcon.astro"; 
import CartShoppingIcon from "../components/icons/CartShoppingIcon.astro";
import GearIcon from "../components/icons/GearIcon.astro";
import HeadSetIcon from "../components/icons/HeadSetIcon.astro";
import AdministratorIcon from "../components/icons/AdministratorIcon.astro";
import IdCardIcon from "../components/icons/IdCardIcon.astro"
---

<Layout title="Nosotros | Lázaro Software">
  <main>
    <!-- ========================= -->
    <!-- HERO PRINCIPAL -->
    <!-- ========================= -->

    <section class="hero-section">
      <!-- Imagen de fondo -->
      <div class="hero-background">
        <img src="/img/us/office.jpg" alt="Lázaro Software" />

        <!-- Capa oscura -->
        <div class="hero-overlay"></div>
      </div>

      <!-- Contenido -->
      <div class="hero-content">
        <div class="hero-text">
          <h1>Nuestra Historia y Compromiso</h1>

          <p>
            Más de 30 años desarrollando soluciones tecnológicas para empresas,
            optimizando procesos administrativos, contables y comerciales.
          </p>
        </div>
      </div>
    </section>

    <!-- ========================= -->
    <!-- SECCIÓN NOSOTROS -->
    <!-- ========================= -->

    <section class="about-section">
      <div class="about-container">
        <div class="about-grid">
          <!-- TEXTO -->
          <div class="about-card">
            <span class="about-label"> QUIÉNES SOMOS </span>

            <div class="about-description">
              <p>
                Lázaro Software es una empresa 100% Tolimense con más de 30 años
                de experiencia desarrollando soluciones informáticas eficientes
                para empresas de diferentes sectores.
              </p>

              <p>
                Nos hemos destacado por la calidad de nuestros productos, el
                compromiso con nuestros clientes y el acompañamiento técnico
                permanente que ofrecemos a cada organización.
              </p>

              <p>
                Diseñamos herramientas robustas, intuitivas y funcionales para
                optimizar procesos de ventas, inventarios, contabilidad,
                facturación electrónica y administración empresarial.
              </p>

              <p>
                Nuestro objetivo es brindar soluciones tecnológicas que ayuden a
                las empresas a crecer, mejorar el control operativo y tomar
                decisiones más inteligentes.
              </p>
            </div>
          </div>

          <!-- LATERAL -->
          <div class="about-side">
            <!-- ESTADÍSTICAS -->
            <div class="stats-grid">
              <div class="stat-card stat-primary">
                <h3>30+</h3>

                <p>Años de experiencia</p>
              </div>

              <div class="stat-card stat-light">
                <h3>100%</h3>

                <p>Talento Tolimense</p>
              </div>
            </div>

            <!-- IMAGEN -->
            <div class="team-card">
              <img src="/img/us/us.png" alt="Equipo Lázaro Software" />

              <div class="team-overlay"></div>

              <div class="team-info">
                <h3>Excelencia Técnica</h3>

                <p>Innovación y compromiso en cada solución.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================= -->
    <!-- SOPORTE -->
    <!-- ========================= -->

    <section class="support-section">
      <div class="container">
        <!-- TITULO -->
        <div class="section-header">
          <h2>Soporte y Atención</h2>

          <p>
            Nuestro equipo está listo para ayudarte y acompañarte en cada etapa
            del crecimiento de tu empresa.
          </p>
        </div>

        <!-- CARDS -->
        <div class="support-grid">
          <!-- CARD VENTAS-->
          <div class="support-card">
            <div class="support-icon">
              <span class="material-symbols-outlined">
                <CartShoppingIcon />
              </span>
            </div>

            <h3>Ventas</h3>

            <p>Asesoría comercial y licenciamiento para empresas.</p>

            <div class="support-phone">
              <span class="material-symbols-outlined">
                <WhatsappIcon />
              </span>

              <span>
                <a
                  href="https://wa.me/573173718032?text=Buen%20día.%0A%0AMi%20nombre%20es%3A%0A%0AY%20requiero%20asesoría%20de%20ventas."
                  target="_blank"
                  style="text-decoration: none; color: #082f49;"
                >
                  +57 317 3718032</a
                >
              </span>
            </div>
          </div>

          <!-- CARD TECNICO -->
          <div class="support-card">
            <div class="support-icon">
              <span class="material-symbols-outlined">
                <GearIcon />
              </span>
            </div>

            <h3>Soporte Técnico</h3>

            <p>
              Soporte técnico especializado para nuestras soluciones
              empresariales.
            </p>

            <div class="support-phone">
              <span class="material-symbols-outlined">
                <WhatsappIcon />
              </span>

              <span>
                <a
                  href="https://wa.me/573168204407?text=Buen%20día%2C%20necesito%20soporte%20técnico.%0AMi%20nombre%20es%3A%0ADe%20la%20empresa%3A%0ADe%20la%20ciudad%3A%0A%0ALa%20falla%20es%3A"
                  target="_blank"
                  rel="noopener noreferrer"
                  style="text-decoration: none; color: #082f49;"
                >
                  +57 3168204407</a
                >
              </span>
            </div>
          </div>

          <!-- CARD SOPORTE -->
          <div class="support-card">
            <div class="support-icon">
              <span class="material-symbols-outlined">
                <HeadSetIcon />
              </span>
            </div>

            <h3>Area de soporte</h3>

            <p>
              Te ayudamos con errores de uso del sistema y enseñamos su
              funcionamiento.
            </p>

            <div class="support-phone">
              <span class="material-symbols-outlined">
                <WhatsappIcon />
              </span>

              <span>
                <a
                  href="https://wa.me/573163977448?text=Buen%20día%2C%20necesito%20soporte.%0A%0AMi%20nombre%20es%3A%0ADe%20la%20empresa%3A%0ADe%20la%20ciudad%3A%0ALa%20falla%20o%20el%20requerimiento%20es%3A"
                  target="_blank"
                  rel="noopener noreferrer"
                  style="text-decoration: none; color: #082f49;"
                >
                  +57 316 3977448</a
                >
              </span>
            </div>
          </div>

          <!-- CARD ADMINISTRATIVO -->
          <div class="support-card">
            <div class="support-icon">
              <span class="material-symbols-outlined">
                <AdministratorIcon />
              </span>
            </div>

            <h3>Area Administrativa</h3>

            <p>
              ¿Quieres agendar alguna cita? U dudas administrativas. Aqui te
              podemos ayudar!
            </p>

            <div class="support-phone">
              <span class="material-symbols-outlined">
                <WhatsappIcon />
              </span>

              <span>
                <a
                  href="https://wa.me/573172277990?text=Hola,%20mi%20nombre%20es:%20%0A%0AMe%20comunico%20de%20la%20empresa:%20%0A%0AY%20requiero%20informaci%C3%B3n%20sobre:%20"
                  target="_blank"
                  rel="noopener noreferrer"
                  style="text-decoration: none; color: #082f49;"
                >
                  +57 317 2277990</a
                >
              </span>
            </div>
          </div>

          <!-- CARD CARTERA-->
          <div class="support-card">
            <div class="support-icon">
              <span class="material-symbols-outlined">
                <IdCardIcon />
            </div>

            <h3>Cartera</h3>

            <p>
              Atención para procesos de cartera. Renueva tu soporte o ponte al
              día.
            </p>

            <div class="support-phone">
              <span class="material-symbols-outlined">
                <WhatsappIcon />
              </span>

              <span>
                <a
                  href="https://wa.me/573151234567?text=Hola%20mi%20nombre%20es:%20%0A%0Ame%20comunico%20de%20la%20empresa:%20%0A%0Ay%20requiero%20informaci%C3%B3n%20sobre:%20"
                  target="_blank"
                  rel="noopener noreferrer"
                  style="text-decoration: none; color: #082f49;"
                >
                  +57 318 3628235</a
                >
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================= -->
    <!-- CTA -->
    <!-- ========================= -->

    <section class="cta-section">
      <div class="container">
        <div class="cta-box">
          <div class="cta-content">
            <div class="cta-text">
              <h2>¿Listo para modernizar tu empresa?</h2>

              <p>
                Descubre cómo nuestras soluciones pueden ayudarte a optimizar
                tus procesos y mejorar la productividad.
              </p>
            </div>

            <button class="cta-button">
              <a
                href="https://wa.me/573173718032?text=Buen%20d%C3%ADa.%0A%0AMi%20nombre%20es%3A%0A%0AY%20requiero%20asesor%C3%ADa%20de%20ventas."
                class="btn-primary"
                target="_blank"
                style="text-decoration: none; color: #082f49;">¡Cotiza ahora!</a
              >
            </button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- ========================= -->
  <!-- ESTILOS CSS -->
  <!-- ========================= -->

  <style>
    /* ========================= */
    /* CONFIGURACIÓN GENERAL */
    /* ========================= */

    .container {
      width: 90%;
      max-width: 1200px;
      margin: 0 auto;
    }

    .material-symbols-outlined {
      color: #006591;
      font-variation-settings:
        "FILL" 0,
        "wght" 400,
        "GRAD" 0,
        "opsz" 24;
    }

    /* ========================= */
    /* HERO */
    /* ========================= */

    .hero-section {
      position: relative;
      min-height: 420px;
      display: flex;
      align-items: center;
      overflow: hidden;
    }

    .hero-background {
      position: absolute;
      inset: 0;
    }

    .hero-background img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .hero-overlay {
      position: absolute;
      inset: 0;

      background: linear-gradient(
        180deg,
        rgba(0, 55, 103, 0.9) 0%,
        rgba(0, 55, 103, 0.7) 100%
      );
    }

    .hero-content {
      position: relative;
      z-index: 2;

      width: 90%;
      max-width: 1200px;
      margin: 0 auto;
    }

    .hero-text {
      max-width: 700px;
    }

    .hero-text h1 {
      font-size: 4rem;
      line-height: 1.1;
      color: white;
      margin-bottom: 24px;
    }

    .hero-text p {
      font-size: 1.2rem;
      line-height: 1.8;
      color: rgba(255, 255, 255, 0.9);
    }

    /* ========================= */
    /* ABOUT */
    /* ========================= */

    .about-section {
      padding: 100px 0;
      background: #f8fafc;
    }

    .about-container {
      width: 90%;
      max-width: 1200px;
      margin: 0 auto;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 40px;
    }

    .about-card {
      background: white;
      padding: 50px;
      border-radius: 28px;

      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }

    .about-label {
      display: block;
      margin-bottom: 24px;

      color: #0284c7;
      font-size: 0.9rem;
      font-weight: bold;
      letter-spacing: 3px;
    }

    .about-description {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .about-description p {
      line-height: 1.8;
      color: #475569;
    }

    /* ========================= */
    /* LATERAL */
    /* ========================= */

    .about-side {
      display: flex;
      flex-direction: column;
      gap: 30px;
    }

    /* ========================= */
    /* ESTADÍSTICAS */
    /* ========================= */

    .stats-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .stat-card {
      padding: 40px 20px;
      border-radius: 24px;
      text-align: center;
    }

    .stat-card h3 {
      font-size: 3rem;
      margin-bottom: 10px;
    }

    .stat-primary {
      background: #082f49;
      color: white;
    }

    .stat-light {
      background: white;
      border: 1px solid #e2e8f0;
    }

    .stat-light h3 {
      color: #082f49;
    }

    .stat-light p {
      color: #64748b;
    }

    /* ========================= */
    /* TEAM CARD */
    /* ========================= */

    .stat-card.stat-light {
      transition: transform 0.7s ease;
    }

    .stat-card.stat-light:hover {
      transform: scale(1.05);
    }

    .stat-card.stat-primary {
      transition: transform 0.7s ease;
    }

    .stat-card.stat-primary:hover {
      transform: scale(1.05);
    }

    .team-card {
      position: relative;
      height: 320px;
      width: 460px;
      overflow: hidden;
      border-radius: 28px;
    }

    .team-card img {
      width: 100%;
      height: 100%;

      object-fit: cover;

      transition: transform 0.7s ease;
    }

    .team-card:hover img {
      transform: scale(1.05);
    }

    .team-overlay {
      position: absolute;
      inset: 0;

      background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.8),
        rgba(0, 0, 0, 0.2),
        transparent
      );
    }

    .team-info {
      position: absolute;
      left: 30px;
      right: 30px;
      bottom: 30px;

      color: white;
    }

    .team-info h3 {
      font-size: 2rem;
      margin-bottom: 10px;
    }

    /* ========================= */
    /* SOPORTE */
    /* ========================= */

    .support-section {
      padding: 100px 0;
      background: white;
    }

    .section-header {
      text-align: center;
      margin-bottom: 60px;
    }

    .section-header h2 {
      font-size: 3rem;
      margin-bottom: 20px;
      color: #082f49;
    }

    .section-header p {
      max-width: 700px;
      margin: 0 auto;

      color: #64748b;
      line-height: 1.8;
    }

    .support-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 30px;
    }

    .support-card {
      background: #f8fafc;
      padding: 40px;
      border-radius: 24px;

      border: 1px solid #e2e8f0;

      transition: 0.3s ease;
    }

    .support-card:hover {
      transform: translateY(-5px);
      border-color: #0284c7;
    }

    .support-icon {
      width: 60px;
      height: 60px;

      border-radius: 18px;

      background: #e0f2fe;
      color: #0284c7;

      display: flex;
      align-items: center;
      justify-content: center;

      margin-bottom: 24px;
    }

    .support-card h3 {
      font-size: 1.7rem;
      margin-bottom: 16px;
    }

    .support-card p {
      color: #64748b;
      line-height: 1.8;
      margin-bottom: 30px;
    }

    .support-phone {
      padding-top: 20px;
      border-top: 1px solid #cbd5e1;

      display: flex;
      align-items: center;
      gap: 10px;

      color: #082f49;
      font-weight: bold;
    }

    /* ========================= */
    /* CTA */
    /* ========================= */

    .cta-section {
      padding: 100px 0;
      background: #f8fafc;
    }

    .cta-box {
      background: #082f49;
      border-radius: 32px;

      padding: 60px;
    }

    .cta-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 40px;
    }

    .cta-text {
      max-width: 700px;
    }

    .cta-text h2 {
      color: white;
      font-size: 3rem;
      margin-bottom: 20px;
    }

    .cta-text p {
      color: rgba(255, 255, 255, 0.8);
      line-height: 1.8;
    }

    .cta-button {
      border: none;
      cursor: pointer;

      background: white;
      color: #082f49;

      padding: 18px 40px;
      border-radius: 18px;

      font-weight: bold;
      font-size: 1rem;

      transition: 0.3s ease;
    }

    .cta-button:hover {
      transform: scale(1.05);
    }

    /* ========================= */
    /* RESPONSIVE */
    /* ========================= */

    @media (max-width: 992px) {
      .about-grid {
        grid-template-columns: 1fr;
      }

      .support-grid {
        grid-template-columns: 1fr;
      }

      .cta-content {
        flex-direction: column;
        text-align: center;
      }

      .team-card {
        width: auto;
      }
    }

    @media (max-width: 768px) {
      .hero-text h1 {
        font-size: 2.5rem;
      }

      .section-header h2,
      .cta-text h2 {
        font-size: 2.2rem;
      }

      .stats-grid {
        grid-template-columns: 1fr;
      }

      .about-card {
        padding: 35px;
      }

      .cta-box {
        padding: 40px 30px;
      }

      .team-card {
        width: 350px;
      }
    }
  </style>
</Layout>
